<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.type.watch" />
    <!-- Not required: a watch without BLE still logs food and exports by QR, which is the whole
         app minus the phone link. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <!-- Not required either: a watch with no heart rate sensor runs a guided session perfectly well,
         it just shows no bpm line. -->
    <uses-feature android:name="android.hardware.sensor.heartrate" android:required="false" />

    <!-- LIFT Link (docs/LINK-PROTOCOL.md). The watch is the peripheral: it advertises and accepts
         a connection, and it never scans, so BLUETOOTH_SCAN is deliberately absent. With no scan
         permission there is no location question to answer either - neverForLocation belongs on
         the phone, which does scan.

         There is still no INTERNET permission and no Play Services here, and there must not be:
         that constraint is why this link exists at all rather than the Wearable Data Layer. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Android 11 and older, where the two above do not exist. minSdk is 30, so this is one
         API level, and maxSdkVersion keeps them off every device that has the modern pair. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!-- The guided session. BODY_SENSORS is heart rate through Health Services
         (androidx.health:health-services-client), an AndroidX artifact that binds to the watch's own
         Health Services system package. It is NOT Play Services: its whole dependency tree was
         resolved and read before it was added, and PhoneLinkManifestTest asserts that neither this
         manifest nor the build file has ever named a Play Services coordinate. A refused permission
         costs the heart rate and nothing else: sets are logged either way.

         VIBRATE is the buzz at the end of a rest interval, which is the entire reason a rest timer
         on a wrist is worth having. Install-time, so it asks the user nothing. -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="LIFT"
        android:theme="@android:style/Theme.DeviceDefault"
        android:allowBackup="false">
        <meta-data android:name="com.google.android.wearable.standalone" android:value="true" />
        <activity android:name=".MainActivity" android:exported="true" android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
