<?xml version="1.0" encoding="utf-8"?>
<!-- Required from Wear OS 5 on. Without it the system's
     DeclarativeWatchFaceInfoParser calls Resources.getXml(0) and the package
     is rejected as unparseable, with the face never reaching the picker. -->
<WatchFaceInfo>
    <Preview value="@drawable/preview" />
    <Category value="CATEGORY_EMPTY" />
    <AvailableInRetail value="true" />
    <MultipleInstancesAllowed value="true" />
    <Editable value="false" />
</WatchFaceInfo>
