# Credential material — keeps these out of git AND out of `mempalace mine`,
# which filters on .gitignore. Copy or merge into each project's .gitignore.
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
*.ppk
id_rsa*
id_ecdsa*
id_ed25519
*token*.json
*secret*.json
*credential*.json
service-account*.json
*.tfstate
*.tfstate.*
*vault*
*.ovpn
*.kdbx
*.htpasswd
.netrc
.pgpass
.npmrc
.pypirc

*.tfvars
!*.tfvars.example
!*.tfvars.template
*.auto.tfvars
.terraform/
terraform.tfstate.d/
*.retry
vault-password*
.vault_pass*
*.gpg
*.asc
